{
  "enabled": true,
  "namespace": "group2.internal",
  "services": [
    {
      "portName": "service-a-port",
      "discoveryName": "service-a",
      "clientAliases": [
        {
          "port": 3001,
          "dnsName": "service-a"
        }
      ]
    }
  ],
  "logConfiguration": {
    "logDriver": "awslogs",
    "options": {
      "awslogs-group": "/ecs/devops-g2-service-a",
      "awslogs-region": "us-east-2",
      "awslogs-stream-prefix": "ecs-service-connect"
    }
  }
}
