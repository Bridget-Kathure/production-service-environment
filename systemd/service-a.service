[Unit]
Description=Service A - Public API Gateway
After=network.target service-b.service service-c.service
Requires=service-b.service service-c.service

[Service]
Type=simple
User=pearl
WorkingDirectory=/home/pearl/devops-lab/production-service-environment
Environment=PATH=/home/pearl/devops-lab/production-service-environment/venv/bin
ExecStart=/home/pearl/devops-lab/production-service-environment/venv/bin/python3 services/service-a/app.py
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
